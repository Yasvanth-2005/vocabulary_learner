# API base URL used by fetch in the browser (include the /api path).
# Local dev: keep /api so the Vite dev server can proxy requests.
VITE_API_BASE_URL=/api

# Backend origin for the Vite dev-server proxy (no /api suffix).
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Production (npm run build): set VITE_API_BASE_URL to your hosted API, e.g.
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
